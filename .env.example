# Skopiuj do .env.local (lokalnie) albo wpisz w Vercel → Settings → Environment Variables.
# NIE wpisuj tu prawdziwych wartości — ten plik trafia do repozytorium.
#
# W env zostaje tylko to, bez czego aplikacja nie wystartuje. Cała reszta
# (Resend, Discord, Stripe, Google Analytics, Search Console, Vercel Blob, adres strony…)
# ustawiasz w panelu: /panel/admin/ustawienia — bez edytowania plików i bez ponownego wdrożenia.

# Baza danych. Lokalnie wystarczy plik; na produkcji Turso: libsql://… + token
DATABASE_URL=file:./data/afto.db
DATABASE_AUTH_TOKEN=

# Konto administratora (jedno). Logujesz się tymi danymi na /konto/logowanie.
# Użyj długiego, unikalnego hasła.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Klucz szyfrowania sekretów zapisanych w panelu (dowolny długi losowy ciąg, np. openssl rand -hex 32).
# Bez niego sekrety szyfruje klucz pochodny od ADMIN_PASSWORD (po zmianie hasła trzeba je wpisać ponownie).
SECRET_KEY=

# Przypomnienia z kalendarza: Vercel Cron wywołuje /api/cron/reminders z tym sekretem.
CRON_SECRET=

# Opcjonalnie: katalog na zdjęcia przy własnym serwerze (domyślnie data/uploads)
UPLOAD_DIR=

# --- Starsze zmienne (dalej działają jako zapas, ale panel ma pierwszeństwo) ---
# RESEND_API_KEY=  MAIL_FROM=  CONTACT_FROM=  CONTACT_TO=  NOTIFY_EMAIL=  ADMIN_NAME=
# DISCORD_WEBHOOK_URL=  STRIPE_SECRET_KEY=  STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_GA_ID=  NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=  ANALYTICS_SALT=
# BLOB_READ_WRITE_TOKEN=  NEXT_PUBLIC_SITE_URL=
