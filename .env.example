# Skopiuj do .env.local i uzupełnij. Wystarczy jeden kanał — formularz działa, jeśli dojdzie przez Resend LUB Discord.

# Resend — https://resend.com/api-keys (domena afto.works musi być zweryfikowana w Resend)
RESEND_API_KEY=
# Adres nadawcy (z zweryfikowanej domeny)
CONTACT_FROM="afto.works <formularz@afto.works>"
# Gdzie mają trafiać zapytania
CONTACT_TO=kontakt@afto.works

# Discord — Ustawienia kanału → Integracje → Webhooki → Nowy webhook → Kopiuj URL
DISCORD_WEBHOOK_URL=
