# Skopiuj do .env.local i uzupełnij. Wystarczy jeden kanał — formularz działa, jeśli dojdzie przez Resend LUB Discord.

# Resend — https://resend.com/api-keys (domena afto.works musi być zweryfikowana w Resend)
RESEND_API_KEY=
# Adres nadawcy (z zweryfikowanej domeny)
CONTACT_FROM="afto.works <formularz@afto.works>"
# Gdzie mają trafiać zapytania
CONTACT_TO=lubojanskiwojciech1@gmail.com

# Discord — Ustawienia kanału → Integracje → Webhooki → Nowy webhook → Kopiuj URL
DISCORD_WEBHOOK_URL=

# Google Analytics 4 (opcjonalnie) — ładuje się dopiero po zgodzie na cookies analityczne
NEXT_PUBLIC_GA_ID=

# Baza danych (konta, zaproszenia). Lokalnie wystarczy plik; na produkcji Turso: libsql://… + token
DATABASE_URL=file:./data/afto.db
DATABASE_AUTH_TOKEN=

# Konto administratora (jedno). Logujesz się tymi danymi na /konto/logowanie.
# Hasło nie trafia do bazy — użyj długiego, unikalnego hasła.
ADMIN_EMAIL=lubojanskiwojciech1@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Wojtek
# Gdzie wysyłać przypomnienia z kalendarza (domyślnie ADMIN_EMAIL)
NOTIFY_EMAIL=

# Przypomnienia z kalendarza: Vercel Cron wywołuje /api/cron/reminders z tym sekretem.
# Na własnym serwerze (VPS) przypomnienia sprawdzają się same co godzinę.
CRON_SECRET=

# Zdjęcia wgrywane w panelu: domyślnie dysk serwera (data/uploads).
# Na Vercelu dysk nie jest trwały — dodaj Vercel Blob i wklej token:
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=

# Sól do anonimowej analityki (dowolny losowy ciąg)
ANALYTICS_SALT=

# Nadawca maili z kontami (kod zaproszenia, weryfikacja). Bez RESEND_API_KEY w trybie dev kody lądują w konsoli.
MAIL_FROM="afto.works <konto@afto.works>"
# Adres strony używany w linkach i obrazkach w mailach
NEXT_PUBLIC_SITE_URL=https://afto.works

# Google Search Console — wartość „content” z tagu weryfikacyjnego HTML (opcjonalnie)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
